@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}
<h1>Something went wrong</h1>
<p>The portal could not answer this request. If you were publishing, inspect the channel head before retrying.</p>
@if (Model.ShowRequestId)
{
    <p class="muted">Request <code>@Model.RequestId</code></p>
}
