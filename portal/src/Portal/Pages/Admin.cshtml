@page "/admin"
@using Microsoft.Extensions.Options
@inject IOptions<PortalOptions> Options
@inject Portal.Accounts.Registry Registry
@inject Portal.Channels.CommonVisibility Visibility
@functions {
    bool Allowed()=>Options.Value.Policy.Admin && User.Identity?.IsAuthenticated==true && Options.Value.Admins.Split(';',',').Any(name=>name.Trim().Equals(User.Identity.Name,StringComparison.OrdinalIgnoreCase));
    public IActionResult OnPostRights(long id,bool files,bool suspended)
    {
        if(!Allowed())return NotFound();
        Registry.Change(id,record=>record with { Files=files,Suspended=suspended });return Redirect("/admin");
    }
    public IActionResult OnPostVisibility(string channel,bool listed)
    {
        if(!Allowed() || !Portal.Channels.ChannelPaths.IsChannelName(channel))return NotFound();
        Visibility.SetListed(channel,listed);return Redirect("/admin");
    }
}
@{ ViewData["Title"]="Administration"; }
@if(!Allowed()){ Response.StatusCode=404; <h1>Not found</h1> return; }
<h1>Administration</h1>
<p>Publishing rights and channel visibility do not grant package review or client trust.</p>
@foreach(var publisher in Registry.All())
{
    <section class="channel"><h2>@publisher.Name</h2>
    <form method="post" asp-page-handler="Rights"><input type="hidden" name="id" value="@publisher.GitHubId" />
    <label><input type="checkbox" name="files" value="true" checked="@publisher.Files" /> Binary storage</label>
    <label><input type="checkbox" name="suspended" value="true" checked="@publisher.Suspended" /> Suspended</label>
    <button type="submit">Save publishing rights</button></form>
    @foreach(var channel in publisher.Channels.Where(Portal.Channels.ChannelPaths.IsChannelName))
    {
        <form method="post" asp-page-handler="Visibility"><input type="hidden" name="channel" value="@channel" />
        <label>@channel <input type="checkbox" name="listed" value="true" checked="@(!Visibility.IsUnlisted(channel))" /> Listed</label><button type="submit">Save visibility</button></form>
    }
    </section>
}
