@page "/publishers"
@inject Portal.Accounts.Registry Registry
@inject Portal.Channels.CommonVisibility Visibility
@{ ViewData["Title"]="Publishers"; }
<h1>Publishers</h1>
<p>Anyone can <a href="/account">register a publishing key</a>. A new account has its own unlisted channels and publishes external archive links. Review is optional and independent.</p>
@foreach(var publisher in Registry.All().Where(record=>!record.Suspended))
{
    var channels=publisher.Channels.Where(channel=>Visibility.HasPublication(channel) && (Visibility.SeesUnlisted() || !Visibility.IsUnlisted(channel))).ToList();
    if(channels.Count==0)continue;
    <section class="channel"><h2>@publisher.Name</h2><p><code class="digest">@publisher.Key</code></p>
    @foreach(var channel in channels) { <a href="/channels/@channel">@channel</a> }
    </section>
}
