@using Microsoft.Extensions.Options
@inject Portal.Channels.CommonVisibility Visibility
@inject IOptions<PortalOptions> Options
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" /><meta name="robots" content="noindex, nofollow" />
<title>@ViewData["Title"] · APKG Packages</title>
<script src="~/js/theme.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="icon" href="~/favicon.svg" />
</head>
<body>
<header class="top"><div class="wrap top-row">
<a class="brand" href="/"><span class="mark" aria-hidden="true"></span>APKG Packages</a>
<nav class="nav" aria-label="Main">
<a href="/">Packages</a><a href="/publishers">Publishers</a><a href="/docs">Documentation</a><a href="/account">Your account</a>
@if(User.Identity?.IsAuthenticated==true && Options.Value.Admins.Split(';',',').Any(name=>name.Trim().Equals(User.Identity.Name,StringComparison.OrdinalIgnoreCase)))
{ <a href="/admin">Administration</a> }
</nav>
<span class="theme" role="group" aria-label="Theme"><partial name="_ThemeButtons" /></span>
</div></header>
@if(Options.Value.ShowMigrationNotice)
{
    <aside class="wrap migration-notice" role="status" aria-label="Migration notice">
        <strong>Migration in progress — please do not use</strong>
        <p>@PortalOptions.MigrationNotice</p>
    </aside>
}
<main class="wrap">
@if(Visibility.SeesUnlisted()) { <p class="muted small">Unlisted channels are visible in this browser. <a href="/see/off">Stop</a></p> }
@RenderBody()
</main>
<footer class="foot"><p>Signed packages. Independent review. Client-controlled trust.</p>
<p><a href="/docs">Documentation</a> · <a href="/account">Publish here</a> · <a href="https://github.com/pomaros/apkg-fusion">Source</a></p>
<p class="build">@Portal.BuildInfo.Line · Development portal</p></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
</body></html>
