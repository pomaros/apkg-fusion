"""Bounded external archive validation for the portal; no proxy or signing keys."""
import hashlib
import http.client
import ipaddress
import socket
import ssl
from urllib.parse import urljoin, urlsplit


class Refusal(ValueError):
    pass


def address(url, hosts=(), allow_loopback=False):
    if not isinstance(url, str) or len(url) > 2048 or any(ord(c) <= 32 or ord(c) > 126 for c in url):
        raise Refusal('archive link must be a bounded printable HTTPS address')
    parsed = urlsplit(url)
    host = parsed.hostname
    if not host or parsed.username is not None or parsed.password is not None or parsed.fragment or '\\' in url:
        raise Refusal('archive link has an invalid host, credentials or fragment')
    local = allow_loopback and host in ('127.0.0.1', '::1')
    if parsed.scheme != 'https' and not (local and parsed.scheme == 'http'):
        raise Refusal('archive links require HTTPS')
    if hosts and not any(host == h or host.endswith('.' + h) for h in hosts):
        raise Refusal('archive host is not allowed by this portal')
    port = parsed.port or (443 if parsed.scheme == 'https' else 80)
    results = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
    ips = list(dict.fromkeys(result[4][0] for result in results))
    if not ips or any(not ipaddress.ip_address(ip).is_global and
                      not (local and ipaddress.ip_address(ip).is_loopback) for ip in ips):
        raise Refusal('archive links must resolve exclusively to public addresses')
    return parsed, ips, port


def download(url, destination, expected, hosts=(), allow_loopback=False):
    """Pin checked DNS results for the actual socket, including every redirect.

    HTTPSConnection still verifies the original host's TLS certificate/SNI.
    The caller bounds aggregate bytes before calling; expected is signed.
    """
    original = url
    try:
        for redirect in range(6):
            parsed, ips, port = address(url, hosts, allow_loopback)
            connection = (http.client.HTTPSConnection(parsed.hostname, port, timeout=20,
                context=ssl.create_default_context()) if parsed.scheme == 'https'
                else http.client.HTTPConnection(parsed.hostname, port, timeout=20))
            # No second hostname lookup after validation and no environment proxy.
            connection._create_connection = lambda ignored, timeout, source_address=None: socket.create_connection(
                (ips[0], port), timeout, source_address)
            try:
                connection.request('GET', (parsed.path or '/') + ('?' + parsed.query if parsed.query else ''),
                                   headers={'User-Agent': 'APKG-Portal/1', 'Accept-Encoding': 'identity'})
                response = connection.getresponse()
                if response.status in (301, 302, 303, 307, 308):
                    location = response.getheader('Location')
                    if not location or redirect == 5:
                        raise Refusal('archive redirect limit exceeded or location missing')
                    following = urljoin(url, location)
                    if parsed.scheme == 'https' and urlsplit(following).scheme != 'https':
                        raise Refusal('archive redirect cannot downgrade HTTPS')
                    url = following
                    continue
                if response.status != 200 or response.getheader('Content-Encoding', 'identity') != 'identity':
                    raise Refusal('archive download did not return unencoded complete content')
                length = response.getheader('Content-Length')
                if length is not None and int(length) != expected[1]:
                    raise Refusal('archive length differs from its signed reference')
                digest, size = hashlib.sha256(), 0
                with destination.open('xb') as output:
                    while chunk := response.read(min(65536, expected[1] - size + 1)):
                        size += len(chunk)
                        if size > expected[1]:
                            raise Refusal('archive exceeds its signed size')
                        digest.update(chunk)
                        output.write(chunk)
                if (digest.hexdigest(), size) != expected:
                    raise Refusal('archive differs from its signed digest or size')
                return original
            finally:
                connection.close()
        raise Refusal('archive redirect limit exceeded')
    except BaseException:
        destination.unlink(missing_ok=True)
        raise
