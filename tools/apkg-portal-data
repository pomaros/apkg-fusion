"""Private new-portal data backup/restore. Stop all writers before either operation.

Captures the entire data directory, including publisher identities, owner pins,
link mappings, staged uploads and cookie keys. Secrets configured outside this
folder must be backed up separately. This performs no legacy conversion.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import stat
import tempfile
import zipfile

MAX_BYTES=16*1024*1024*1024
MAX_MEMBERS=100000

def members(data):
    result={}
    for path in sorted(data.rglob('*')):
        mode=path.lstat().st_mode
        if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):raise ValueError('only ordinary files/directories may be backed up')
        if stat.S_IMODE(mode)>0o777:raise ValueError('special permission bits are unsupported')
        name=path.relative_to(data).as_posix()
        entry=dict(kind='directory' if path.is_dir() else 'file',mode=stat.S_IMODE(mode))
        if path.is_file():
            entry.update(size=path.stat().st_size,sha256=hash_file(path))
        result[name]=entry
    if len(result)>MAX_MEMBERS or sum(item.get('size',0) for item in result.values())>MAX_BYTES:raise ValueError('backup exceeds bounds')
    return result

def hash_file(path):
    digest=hashlib.sha256()
    with path.open('rb') as stream:
        for part in iter(lambda:stream.read(1024*1024),b''):digest.update(part)
    return digest.hexdigest()

def backup(data,archive):
    if data.is_symlink() or not data.is_dir():raise ValueError('data must be an ordinary directory')
    if archive.exists() or archive.is_symlink():raise ValueError('backup must not exist')
    if archive.resolve().is_relative_to(data.resolve()):raise ValueError('backup must be outside data')
    if stat.S_IMODE(data.stat().st_mode)>0o777:raise ValueError('special root permission bits are unsupported')
    archive.parent.mkdir(parents=True,exist_ok=True)
    listing=members(data)
    descriptor=dict(format='apkg-portal-backup-1',root_mode=stat.S_IMODE(data.stat().st_mode),members=listing)
    fd,temp=tempfile.mkstemp(prefix='.apkg-backup-',dir=archive.parent)
    try:
        os.close(fd)
        with zipfile.ZipFile(temp,'w',compression=zipfile.ZIP_STORED,allowZip64=True) as output:
            output.writestr('manifest.json',json.dumps(descriptor,sort_keys=True,separators=(',',':')))
            for name,item in listing.items():
                if item['kind']=='file':output.write(data/name,'data/'+name)
        if members(data)!=listing:raise ValueError('data changed during backup; stop every writer and retry')
        # Exclusive publication, without replacing an existing backup.
        os.link(temp,archive)
    finally:os.unlink(temp)
    return dict(result='backed-up',members=len(listing),sha256=hash_file(archive))

def safe_name(name):
    path=PurePosixPath(name)
    return bool(name) and not path.is_absolute() and '\\' not in name and ':' not in name and all(part not in ('','..','.') for part in name.split('/'))

def restore(archive,data):
    if data.exists() or data.is_symlink():raise ValueError('restore destination must not exist')
    data.parent.mkdir(parents=True,exist_ok=True)
    with zipfile.ZipFile(archive) as source:
        entries=source.infolist()
        if len(entries)>MAX_MEMBERS+1 or sum(item.file_size for item in entries)>MAX_BYTES:raise ValueError('backup exceeds bounds')
        if len({item.filename for item in entries})!=len(entries):raise ValueError('duplicate backup entries')
        if source.getinfo('manifest.json').file_size>16*1024*1024:raise ValueError('manifest exceeds bound')
        manifest=json.loads(source.read('manifest.json'))
        if manifest['format']!='apkg-portal-backup-1':raise ValueError('unknown backup format')
        if type(manifest['root_mode']) is not int or not 0<=manifest['root_mode']<=0o777:raise ValueError('unsafe root mode')
        listing=manifest['members']
        if len(listing)>MAX_MEMBERS or any(not safe_name(name) for name in listing):raise ValueError('unsafe backup paths')
        expected={'manifest.json'}|{'data/'+name for name,item in listing.items() if item['kind']=='file'}
        if set(item.filename for item in entries)!=expected:raise ValueError('unexpected backup members')
        if any(item['kind'] not in ('file','directory') or type(item['mode']) is not int or item['mode']<0 or item['mode']>0o777 for item in listing.values()):raise ValueError('unsafe backup member type/mode')
        with tempfile.TemporaryDirectory(prefix='.apkg-restore-',dir=data.parent) as temporary:
            root=Path(temporary)/'data';root.mkdir(mode=0o700)
            for name,item in sorted(listing.items(),key=lambda pair:(pair[0].count('/'),pair[0])):
                path=root/name
                path.parent.mkdir(parents=True,exist_ok=True)
                if item['kind']=='directory':path.mkdir(exist_ok=True)
                else:
                    with source.open('data/'+name) as incoming,path.open('xb') as outgoing:
                        import shutil
                        shutil.copyfileobj(incoming,outgoing,1024*1024)
                    if path.stat().st_size!=item['size'] or hash_file(path)!=item['sha256']:raise ValueError('backup digest/size mismatch')
            # Apply directory permissions last so read-only directories work too.
            for name,item in sorted(listing.items(),key=lambda pair:pair[0].count('/'),reverse=True):
                (root/name).chmod(item['mode'])
            root.chmod(manifest['root_mode'])
            if members(root)!=listing:raise ValueError('restored tree differs from manifest')
            os.rename(root,data)
    return dict(result='restored',members=len(listing),sha256=hash_file(archive))

if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('operation',choices=['backup','restore'])
    parser.add_argument('--data',required=True,type=Path)
    parser.add_argument('--archive',required=True,type=Path)
    parser.add_argument('--stopped',required=True,action='store_true',help='assert that all portal writers are stopped')
    args=parser.parse_args()
    result=backup(args.data.absolute(),args.archive.absolute()) if args.operation=='backup' else restore(args.archive.absolute(),args.data.absolute())
    print(json.dumps(result,sort_keys=True))
