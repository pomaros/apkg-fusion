; Self-update of arospkg installed by apkg as a package, in a root whose
; path has spaces: from the published 0.6.0, with a user's changed icon,
; through rollback, with a copy outside the root, and stopped dead inside
; the package's own transaction. Then a copy with two installations it
; could belong to, and a PkgManager running from the installation a Shell
; update would replace.
FailAt 21
Set H RAM:rxt/hc
Set MR "SYS:SUT/Root With Space"
Set M "SYS:SUT/Root With Space/arospkg"
Set OLD "SYS:SUT/Old Apps/arospkg-0.6.0.x86_64-aros-v11"
MakeDir "$MR"

; ---- M1: 0.6.0 installed from a catalogue, then updated in place.
Echo "== m1a: install arospkg 0.6.0 as a package" >RESULTS:arospkg-{{R}}/{{R}}-m1.txt
RAM:rxt/apkg-r2 --root "$MR" --index RAM:rxt/idx060.json install arospkg >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
Echo "rc=$RC want=0" >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
Copy RAM:rxt/user.info "$M/PkgManager.info"
$H assert-hash "$M/PkgManager.info" {{IUSER}} >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
Echo "== m1b: 0.6.0's own self-update replaces only its file in the package" >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
"$M/apkg" --root "$MR" --self-update-from https://10.0.2.2/r2/ self-update >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
Echo "rc=$RC want=0" >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
$H assert-hash "$M/apkg" {{A2}} >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
Echo "== m1c: the new apkg replaces the package as an upgrade" >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
"$M/apkg" --root "$MR" --self-update-from https://10.0.2.2/r2/ self-update >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
Echo "rc=$RC want=0" >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
$H assert-hash "$M/apkg" {{A2}} >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
$H assert-hash "$M/PkgManager" {{P2}} >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
$H assert-hash "$M/BUILD.txt" {{B2}} >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
$H assert-hash "$M/PkgManager.info" {{IUSER}} >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
"$M/apkg" --root "$MR" info arospkg >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
"$M/apkg" --root "$MR" verify arospkg >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
Echo "verify rc=$RC" >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
"$M/apkg" --root "$MR" list >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
Echo "== m1d: apkg rollback arospkg goes back to 0.6.0; the icon stays the user's" >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
"$M/apkg" --root "$MR" rollback arospkg >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
Echo "rc=$RC want=0" >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
$H assert-hash "$M/PkgManager" {{P060}} >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
$H assert-hash "$M/apkg" {{A060}} >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt
$H assert-hash "$M/PkgManager.info" {{IUSER}} >>RESULTS:arospkg-{{R}}/{{R}}-m1.txt

; ---- M2: a copy outside the root, tied to the package with --drawer:
; both to the release in one update.
MakeDir "SYS:SUT/Copy M"
Copy RAM:rxt/apkg-b1 "SYS:SUT/Copy M/apkg"
Protect "SYS:SUT/Copy M/apkg" +e
Echo "== m2: the copy and the package together" >RESULTS:arospkg-{{R}}/{{R}}-m2.txt
"SYS:SUT/Copy M/apkg" --root "$MR" --self-update-from https://10.0.2.2/r2/ self-update --drawer "$M" >>RESULTS:arospkg-{{R}}/{{R}}-m2.txt
Echo "rc=$RC want=0" >>RESULTS:arospkg-{{R}}/{{R}}-m2.txt
$H assert-hash "SYS:SUT/Copy M/apkg" {{A2}} >>RESULTS:arospkg-{{R}}/{{R}}-m2.txt
$H assert-hash "$M/apkg" {{A2}} >>RESULTS:arospkg-{{R}}/{{R}}-m2.txt
$H assert-hash "$M/PkgManager" {{P2}} >>RESULTS:arospkg-{{R}}/{{R}}-m2.txt
$H assert-hash "$M/PkgManager.info" {{IUSER}} >>RESULTS:arospkg-{{R}}/{{R}}-m2.txt
"$M/apkg" --root "$MR" verify arospkg >>RESULTS:arospkg-{{R}}/{{R}}-m2.txt
Echo "verify rc=$RC" >>RESULTS:arospkg-{{R}}/{{R}}-m2.txt

; ---- MR: stopped dead inside the package's transaction, after the copy
; was replaced: the package's own recovery rolls it back, and the copy
; follows it back.
"$M/apkg" --root "$MR" rollback arospkg >NIL:
Copy RAM:rxt/apkg-b1 "SYS:SUT/Copy M/apkg"
Echo "== mr: stop inside the package transaction (old drawer moved aside)" >RESULTS:arospkg-{{R}}/{{R}}-mr.txt
$H assert-hash "$M/PkgManager" {{P060}} >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
"SYS:SUT/Copy M/apkg" --root "$MR" --self-update-from https://10.0.2.2/r2/ --self-update-fail-at managed:9 self-update >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
Echo "rc=$RC want=20" >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
$H assert-hash "SYS:SUT/Copy M/apkg" {{A2}} >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
Type ENVARC:arospkg/self-update.json >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
Echo "== mr: --recover: the package back to 0.6.0, the copy back too" >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
"SYS:SUT/Copy M/apkg" self-update --recover >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
Echo "rc=$RC want=0" >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
$H assert-hash "SYS:SUT/Copy M/apkg" {{A1}} >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
$H assert-hash "$M/PkgManager" {{P060}} >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
$H assert-hash "$M/apkg" {{A060}} >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
"$M/apkg" --root "$MR" info arospkg >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
Echo "== mr: and then the update goes through" >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
"SYS:SUT/Copy M/apkg" --root "$MR" --self-update-from https://10.0.2.2/r2/ self-update >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
Echo "rc=$RC want=0" >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
$H assert-hash "SYS:SUT/Copy M/apkg" {{A2}} >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
$H assert-hash "$M/PkgManager" {{P2}} >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
$H assert-hash "$M/PkgManager.info" {{IUSER}} >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
"$M/apkg" --root "$MR" verify arospkg >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
Echo "verify rc=$RC" >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt
List "$MR/tmp" "$MR/db/transactions" >>RESULTS:arospkg-{{R}}/{{R}}-mr.txt


; ---- MV: the package changes while a self-update waits between its plan
; and its swap: first another revision of the same version, then a newer
; version. The self-update refuses both times and leaves them as they are.
"$M/apkg" --root "$MR" rollback arospkg >NIL:
Copy RAM:rxt/apkg-b1 "SYS:SUT/Copy M/apkg"
Assign SUCM: "SYS:SUT/Copy M"
Assign SUMR: "$MR"
Delete RAM:su-go-m RAM:su-go-n RAM:su-mv1.out RAM:su-mv1.rc RAM:su-mv2.out RAM:su-mv2.rc QUIET
Echo "== mv: start at 0.6.0" >RESULTS:arospkg-{{R}}/{{R}}-mv.txt
"$M/apkg" --root "$MR" info arospkg >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
Run >NIL: Execute RAM:rxt/bg-mv1.script
Wait 40
Echo "== mv: meanwhile 0.6.0 revision 2 is installed" >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
RAM:rxt/apkg-r2 --root "$MR" --index RAM:rxt/idx060r2.json upgrade arospkg >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
Echo "upgrade rc=$RC" >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
Echo "go" >RAM:su-go-m
Lab waitmv1
If NOT EXISTS RAM:su-mv1.rc
  Wait 2
  Skip waitmv1 BACK
EndIf
Type RAM:su-mv1.out RAM:su-mv1.rc >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
"$M/apkg" --root "$MR" info arospkg >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
$H assert-hash "$M/PkgManager" {{P060}} >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
$H assert-hash SUCM:apkg {{A1}} >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
Run >NIL: Execute RAM:rxt/bg-mv2.script
Wait 40
Echo "== mv: meanwhile 0.8.0 is installed" >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
RAM:rxt/apkg-r2 --root "$MR" --index RAM:rxt/idx080.json upgrade arospkg >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
Echo "upgrade rc=$RC" >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
Echo "go" >RAM:su-go-n
Lab waitmv2
If NOT EXISTS RAM:su-mv2.rc
  Wait 2
  Skip waitmv2 BACK
EndIf
Type RAM:su-mv2.out RAM:su-mv2.rc >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
"$M/apkg" --root "$MR" info arospkg >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
$H assert-hash "$M/PkgManager" {{P3}} >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
$H assert-hash SUCM:apkg {{A1}} >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
"$M/apkg" --root "$MR" verify arospkg >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
Echo "verify rc=$RC" >>RESULTS:arospkg-{{R}}/{{R}}-mv.txt
Assign SUCM: REMOVE
Assign SUMR: REMOVE

; ---- A2: a copy that could belong to two installations: the package in
; the root in use, and the drawer a running PkgManager announces. Never
; guessed: refused in a script, until --drawer or --apkg-only says.
; Run drops the quotes of a path with spaces (~/Work/AROS/CLAUDE.md): an assign.
Assign SUOLD: "$OLD"
Run >NIL: SUOLD:PkgManager --root "SYS:SUT/No Root"
Wait 20
MakeDir "SYS:SUT/Tools Two"
Copy RAM:rxt/apkg-b1 "SYS:SUT/Tools Two/apkg"
Protect "SYS:SUT/Tools Two/apkg" +e
Echo "== a2: PkgManager runs from the drawer of S1 (its Shell's number):" >RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Status COMMAND SUOLD:PkgManager >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Echo "== a2a: two candidates, a script with no console: refused, both listed" >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
"SYS:SUT/Tools Two/apkg" <NIL: --root "$MR" --self-update-from https://10.0.2.2/r2/ self-update >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Echo "rc=$RC want=5" >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
$H assert-hash "SYS:SUT/Tools Two/apkg" {{A1}} >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Echo "== a2b: --apkg-only: this apkg alone, recorded" >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
"SYS:SUT/Tools Two/apkg" --root "$MR" --self-update-from https://10.0.2.2/r2/ self-update --apkg-only >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Echo "rc=$RC want=0" >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
$H assert-hash "SYS:SUT/Tools Two/apkg" {{A2}} >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Echo "== a2c: the record decides from now on" >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
"SYS:SUT/Tools Two/apkg" --root "$MR" --self-update-from https://10.0.2.2/r2/ self-update --check >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Echo "rc=$RC want=0" >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Echo "== l2: C:apkg belongs to the drawer PkgManager runs from: refused while it runs" >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
C:apkg --root "SYS:SUT/No Root" --self-update-from https://10.0.2.2/r3/ self-update >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Echo "rc=$RC want=10" >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
$H assert-hash C:apkg {{A2}} >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
$H assert-hash "$OLD/PkgManager" {{P2}} >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Status >ENV:supm COMMAND SUOLD:PkgManager
Break $supm
Wait 10
Assign SUOLD: REMOVE
Echo "== l2b: PkgManager closed: the same update goes through" >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
C:apkg --root "SYS:SUT/No Root" --self-update-from https://10.0.2.2/r3/ self-update >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Echo "rc=$RC want=0" >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
$H assert-hash C:apkg {{A3}} >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
$H assert-hash "$OLD/PkgManager" {{P3}} >>RESULTS:arospkg-{{R}}/{{R}}-a2.txt
Echo "managed done" >RESULTS:arospkg-{{R}}/{{R}}-managed-done.txt
; Results to the host as they are (tests/tools/recv.py), the marker last.
RAM:rxt/putfile RESULTS:arospkg-{{R}}/{{R}}-m1.txt >NIL:
RAM:rxt/putfile RESULTS:arospkg-{{R}}/{{R}}-m2.txt >NIL:
RAM:rxt/putfile RESULTS:arospkg-{{R}}/{{R}}-mr.txt >NIL:
RAM:rxt/putfile RESULTS:arospkg-{{R}}/{{R}}-a2.txt >NIL:
RAM:rxt/putfile RESULTS:arospkg-{{R}}/{{R}}-mv.txt >NIL:
RAM:rxt/putfile RESULTS:arospkg-{{R}}/{{R}}-managed-done.txt >NIL:
